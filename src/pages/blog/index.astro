---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base title="Writing" description="Essays and notes by Craig Stevenson.">
  <h1 class="mb-8 text-2xl font-semibold tracking-tight">Writing</h1>
  {posts.length === 0 ? (
    <p class="text-neutral-600 dark:text-neutral-400">No posts yet.</p>
  ) : (
    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}`} class="group block">
            <h2 class="font-medium group-hover:underline">{post.data.title}</h2>
            <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">{post.data.description}</p>
            <time datetime={post.data.date.toISOString()} class="mt-1 block text-xs text-neutral-500">
              {fmt(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )}
</Base>
