---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Craig Stevenson">
  <section class="mb-16">
    <h1 class="text-3xl font-semibold tracking-tight">Hi, I'm Craig.</h1>
    <p class="mt-4 text-lg">
      I think software can be simpler.  I focus on python, javascript, and the web. I love building simple interfaces to solve complex problems.  
    </p>
    <p class="mt-4 text-lg">
      Happy to talk about how to get your startup from zero to one.  The best way to reach me is <a href='https://www.linkedin.com/in/craig-stevenson-hq/'>LinkedIn</a>.
    </p>
  </section>

  {projects.length > 0 && (
    <section class="mb-16">
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">Recent projects</h2>
        <a href="/projects" class="text-sm text-neutral-600 hover:underline dark:text-neutral-400">All projects →</a>
      </div>
      <ul class="space-y-4">
        {projects.map((project) => (
          <li>
            <a href={`/projects/${project.slug}`} class="group block">
              <h3 class="font-medium group-hover:underline">{project.data.title}</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{project.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {articles.length > 0 && (
    <section>
      <div class="mb-4 flex items-baseline justify-between">
        <h2 class="text-sm font-medium uppercase tracking-wider text-neutral-500">Recent articles</h2>
        <a href="/articles" class="text-sm text-neutral-600 hover:underline dark:text-neutral-400">All articles →</a>
      </div>
      <ul class="space-y-4">
        {articles.map((article) => (
          <li>
            <a href={`/articles/${article.slug}`} class="group block">
              <h3 class="font-medium group-hover:underline">{article.data.title}</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{article.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
